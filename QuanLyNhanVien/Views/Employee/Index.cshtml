@model IEnumerable<QuanLyNhanVien.Models.Employee>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="fw-bold">
        Danh sách nhân viên
    </h2>

    <div class="d-flex gap-2">

        <a asp-action="Create" class="btn btn-primary">
            + Thêm nhân viên
        </a>

        <a asp-action="ExportExcel" class="btn btn-success">
            Xuất Excel
        </a>

    </div>

</div>

<div class="card p-3">

    <table class="table table-hover align-middle">

        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Mã NV</th>
                <th>Khu vực</th>
                <th>Ngày</th>
                <th>Ghi chú</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.HoTen</td>

                    <td>@item.MaNhanVien</td>

                    <td>@item.KhuVuc</td>

                    <td>@item.Ngay.ToString("dd/MM/yyyy")</td>

                    <td>@item.GhiChu</td>

                    <td>

                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">

                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">

                                Xóa
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>