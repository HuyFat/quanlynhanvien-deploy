@model IEnumerable<QuanLyNhanVien.Models.Employee>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

    <div>

        <h2 class="fw-bold mb-1">
            Danh sách nhân viên
        </h2>

        <p class="text-muted mb-0">
            Quản lý thông tin nhân viên
        </p>

    </div>

</div>

<!-- FORM TÌM KIẾM -->

<div class="card p-3 mb-4 shadow-sm border-0">

    <form asp-action="Index"
          method="get"
          class="row g-3 align-items-end">

        <!-- CHỌN KHU VỰC -->

        <div class="col-md-4">

            <label class="form-label fw-semibold">
                Chọn khu vực
            </label>

            <select name="khuVuc" class="form-select">

                <option value="">-- Chọn khu vực --</option>

                <option value="Q4">Q4</option>
                <option value="Q5">Q5</option>
                <option value="Q7">Q7</option>
                <option value="Nhà Bè">Nhà Bè</option>
                <option value="Cần Giờ">Cần Giờ</option>
                <option value="Bình Chánh">Bình Chánh</option>
                <option value="Đội 1">Đội 1</option>
                <option value="Đội 2">Đội 2</option>

            </select>

        </div>

        <!-- TÌM THEO TÊN HOẶC MÃ -->

        <div class="col-md-4">

            <label class="form-label fw-semibold">
                Tìm theo tên hoặc mã NV
            </label>

            <input type="text"
                   name="searchString"
                   value="@Context.Request.Query["searchString"]"
                   class="form-control"
                   placeholder="Nhập tên hoặc mã NV..."
                   @(string.IsNullOrEmpty(Context.Request.Query["khuVuc"])
                        ? "disabled"
                        : "") />

        </div>

        <!-- BUTTON -->

        <div class="col-md-4 d-flex gap-2 flex-wrap">

            <button type="submit"
                    class="btn btn-dark">

                🔍 Tìm kiếm

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Reset

            </a>

            <a asp-action="Create"
               class="btn btn-primary">

                + Thêm thông tin

            </a>

            <a asp-action="ExportExcel"
               class="btn btn-success">

                Xuất Excel

            </a>

        </div>

    </form>

</div>

<!-- TABLE -->

<div class="card shadow-lg border-0 table-responsive">

    <div class="card-body p-0">

        <table class="table custom-table align-middle mb-0">

            <thead>

                <tr>

                    <th>STT</th>
                    <th>Họ tên</th>
                    <th>Mã NV</th>
                    <th>Khu vực</th>
                    <th>Ngày</th>
                    <th>Ghi chú</th>
                    <th class="text-center">Hành động</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int stt = 1;
                }

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-4 text-muted">

                            Không tìm thấy nhân viên nào

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @stt
                            </td>

                            <td>

                                <div class="fw-semibold">
                                    @item.HoTen
                                </div>

                            </td>

                            <td>

                                <span class="badge bg-primary">
                                    @item.MaNhanVien
                                </span>

                            </td>

                            <td>
                                @item.KhuVuc
                            </td>

                            <td>
                                @item.Ngay.ToString("dd/MM/yyyy")
                            </td>

                            <td class="text-muted">
                                @item.GhiChu
                            </td>

                            <td>

                                <div class="d-flex gap-2 justify-content-center flex-wrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm px-3">

                                        Sửa

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm px-3">

                                        Xóa

                                    </a>

                                </div>

                            </td>

                        </tr>

                        stt++;
                    }
                }

            </tbody>

        </table>

    </div>

</div>