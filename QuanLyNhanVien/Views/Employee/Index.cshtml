@model List<QuanLyNhanVien.Models.Employee>

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Danh sách nhân viên</h1>
            <p class="text-muted mb-0">Quản lý thông tin nhân viên, sửa, xóa và xuất dữ liệu Excel.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/Employee/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Thêm mới nhân viên
            </a>
            <a href="/Employee/ExportExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info rounded-0 mb-0">Chưa có nhân viên nào. <a href="/Employee/Create">Thêm mới</a></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hình ảnh</th>
                                <th>Họ tên</th>
                                <th>Mã NV</th>
                                <th>Khu vực</th>
                                <th>Ngày</th>
                                <th>Ghi chú</th>
                                <th>Vị trí</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath" alt="@item.HoTen" class="rounded" style="max-width: 60px; height: auto;" />
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No Image</span>
                                        }
                                    </td>
                                    <td>@item.HoTen</td>
                                    <td>@item.MaNhanVien</td>
                                    <td><span class="badge badge-khuvuc">@item.KhuVuc</span></td>
                                    <td>@item.Ngay.ToString("dd/MM/yyyy")</td>
                                    <td>@item.GhiChu</td>
                                    <td>
                                        @(item.Latitude.HasValue && item.Longitude.HasValue ? $"{item.Latitude:F5}, {item.Longitude:F5}" : "Không có")
                                    </td>
                                    <td class="text-center">
                                        <a href="/Employee/Edit/@item.Id" class="btn btn-sm btn-warning me-1 mb-1">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a href="/Employee/Delete/@item.Id" class="btn btn-sm btn-danger mb-1">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>