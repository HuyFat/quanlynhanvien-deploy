@model IEnumerable<QuanLyNhanVien.Models.Employee>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

    <div>
        <h2 class="fw-bold mb-1">
            Danh sách nhân viên
        </h2>

        <p class="text-muted mb-0">
            Quản lý thông tin nhân viên
        </p>
    </div>

    <div class="d-flex gap-2 flex-wrap align-items-center">

    <form asp-action="Index" method="get" class="d-flex gap-2 flex-wrap">

        <input type="text"
               name="searchString"
               value="@Context.Request.Query["searchString"]"
               class="form-control"
               placeholder="Tìm Họ tên hoặc Mã NV..."
               style="min-width: 240px;" />

        <button type="submit" class="btn btn-dark">
            Tìm
        </button>

    </form>

    <a asp-action="Create" class="btn btn-primary">
        + Thêm thông tin
    </a>

    <a asp-action="ExportExcel" class="btn btn-success">
        Xuất Excel
    </a>

</div>

</div>

<div class="card shadow-lg border-0 table-responsive">

    <div class="card-body p-0">

        

            <table class="table custom-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>STT</th>
                        <th>Họ tên</th>
                        <th>Mã NV</th>
                        <th>Khu vực</th>
                        <th>Ngày</th>
                        <th>Ghi chú</th>
                        <th class="text-center">Hành động</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int stt = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @stt
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @item.HoTen
                                </div>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @item.MaNhanVien
                                </span>
                            </td>

                            <td>
                                @item.KhuVuc
                            </td>

                            <td>
                                @item.Ngay.ToString("dd/MM/yyyy")
                            </td>

                            <td class="text-muted">
                                @item.GhiChu
                            </td>

                            <td>

                                <div class="d-flex gap-2 justify-content-center flex-wrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm px-3">

                                        Sửa
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm px-3">

                                        Xóa
                                    </a>

                                </div>

                            </td>

                        </tr>

                        stt++;
                    }

                </tbody>

            </table>

        

    </div>

</div>